# Slack Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_CHANNEL_ID=C0123456789

FORECAST_NETILFY_PREVIEW_HOOK=https://api.netlify.com/build_hooks/68e6ec4bd7244675a2e975a5
FORECAST_NETILFY_PRODUCTION_HOOK=https://api.netlify.com/build_hooks/68e523135fe419079125cb36
FORECAST_NETLIFY_PREVIEW_URL=https://devserver-production-portals--resilient-epi-portals.netlify.app/portal/CoSD-ILI-Report
FORECAST_NETLIFY_PRODUCTION_URL=https://epi-portals.resilienthub.orgportal/CoSD-ILI-Report

# Netlify Configuration
NETLIFY_PREVIEW_URL=https://preview.example.netlify.app
NETLIFY_PRODUCTION_URL=https://example.netlify.app
NETLIFY_PREVIEW_HOOK=https://api.netlify.com/build_hooks/your-preview-hook-id
NETLIFY_PRODUCTION_HOOK=https://api.netlify.com/build_hooks/your-production-hook-id

# Custom Messages
NETLIFY_REJECT_MESSAGE=Please edit the prompts in Airtable and trigger a new preview when ready.

# Webhook Configuration (optional)
WEBHOOK_SECRET=your-secret-key-for-dagster-webhook
WEBHOOK_PORT=5000

# Email Configuration
# Used by both netlify_triggers/app.py (approval notifications) and
# workflows/sim (LLM-generated forecast notifications)
EMAIL_ENABLED=false
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
# Sender email address (e.g., notifications@example.com)
EMAIL_FROM=
EMAIL_PASSWORD=
# Recipient email addresses (comma-separated: user1@example.com,user2@example.com)
EMAIL_TO=

# OAuth2 Configuration for Office 365 (recommended for UCSD accounts)
# You'll need to create an Azure AD app registration to get these values
OFFICE365_CLIENT_ID=
OFFICE365_CLIENT_SECRET=
OFFICE365_TENANT_ID=
